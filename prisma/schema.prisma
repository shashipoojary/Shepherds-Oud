generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(FAMILY)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedProviderId String?   @unique
  linkedProvider   Provider? @relation(fields: [linkedProviderId], references: [id])

  intakes             Intake[]
  guidedIntakes       Intake[]         @relation("CareGuideIntakes")
  providerInvitesSent ProviderInvite[] @relation("ProviderInvitesSent")
  sessions            Session[]
  accounts            Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Intake {
  id                        String       @id @default(cuid())
  contactName               String
  email                     String
  phone                     String
  relationship              String
  preferredArea             String
  ageRange                  String
  careTypes                 String[]
  urgency                   String
  budget                    String?
  languages                 String[]
  additionalNeeds           String[]
  livingSituation           String?
  moveInTimeline            String?
  mobility                  String?
  dementiaNeeds             String?
  hospitalDischargeDate     DateTime?
  decisionMakerName         String?
  decisionMakerRelationship String?
  emotionalSupportNeeds     String[]
  supportTypes              String[]
  notes                     String?
  preferredDistance         String?
  medicalSupportNeeds       String?
  status                    IntakeStatus @default(NEW)
  careGuideId               String?
  carePathway               String?
  assessmentNotes           String?
  carePlanSummary           String?
  visitScheduledAt          DateTime?
  visitType                 String?
  visitProviderName         String?
  visitNotes                String?
  followUp7At               DateTime?
  followUp30At              DateTime?
  followUp90At              DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  careGuide User?   @relation("CareGuideIntakes", fields: [careGuideId], references: [id])
  matches   Match[]

  @@index([careGuideId])
}

model Provider {
  id                 String   @id @default(cuid())
  name               String
  type               String
  area               String
  description        String   @default("")
  languages          String[]
  services           String[]
  careLevels         String[] @default([])
  dementiaCapacity   String?
  fundingTypes       String[] @default([])
  responseTimeHours  Int?
  visitAvailability  String?
  priceMin           Int?
  priceMax           Int?
  bedsTotal          Int?
  bedsOpen           Int?
  waitlistText       String?
  contactName        String?
  email              String?
  phone              String?
  city               String?
  province           String?
  website            String?
  availabilityStatus String?
  adminNotes         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User?
  matches Match[]
}

model Match {
  id            String      @id @default(cuid())
  score         Int
  status        MatchStatus @default(SUGGESTED)
  notes         String?
  declineReason String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  intakeId   String
  providerId String
  intake     Intake   @relation(fields: [intakeId], references: [id])
  provider   Provider @relation(fields: [providerId], references: [id])

  @@unique([intakeId, providerId])
}

model ActionLog {
  id         String   @id @default(cuid())
  type       String
  targetType String
  targetId   String
  label      String
  payload    Json?
  createdAt  DateTime @default(now())
}

enum Role {
  FAMILY
  PROVIDER
  ADMIN
}

enum IntakeStatus {
  NEW
  CARE_GUIDE_ASSIGNED
  ASSESSMENT
  CARE_PLAN
  MATCHED
  VISIT_SCHEDULED
  PROVIDER_RESPONSE
  PLACEMENT_IN_PROGRESS
  PLACED
  FOLLOW_UP_7
  FOLLOW_UP_30
  FOLLOW_UP_90
  CLOSED
}

enum MatchStatus {
  SUGGESTED
  CONTACTED
  VISIT_REQUESTED
  CALLBACK_REQUESTED
  ACCEPTED
  DECLINED
  PLACED
  CLOSED
}

enum WaitlistType {
  FAMILY
  FACILITY
}

enum WaitlistStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model WaitlistEntry {
  id           String         @id @default(cuid())
  type         WaitlistType
  contactName  String
  email        String
  phone        String?
  city         String?
  province     String?
  message      String?
  relationship String?
  ageRange     String?
  careTypes    String[]       @default([])
  facilityName String?
  facilityType String?
  bedsTotal    Int?
  services     String[]       @default([])
  status       WaitlistStatus @default(NEW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  providerInvites ProviderInvite[]
}

model ProviderInvite {
  id              String               @id @default(cuid())
  email           String
  tokenHash       String               @unique
  status          ProviderInviteStatus @default(PENDING)
  waitlistEntryId String?
  providerId      String?
  invitedById     String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  waitlistEntry WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id])
  invitedBy     User?          @relation("ProviderInvitesSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([waitlistEntryId])
  @@index([invitedById])
}

enum ProviderInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

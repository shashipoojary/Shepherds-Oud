
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(FAMILY)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedProviderId String?   @unique
  linkedProvider   Provider? @relation(fields: [linkedProviderId], references: [id])

  intakes  Intake[]
  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Intake {
  id              String       @id @default(cuid())
  contactName     String
  email           String
  phone           String
  relationship    String
  preferredArea   String
  ageRange        String
  careTypes       String[]
  urgency         String
  budget          String?
  languages       String[]
  additionalNeeds String[]
  notes           String?
  status          IntakeStatus @default(NEW)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  matches Match[]
}

model Provider {
  id                 String   @id @default(cuid())
  name               String
  type               String
  area               String
  description        String   @default("")
  languages          String[]
  services           String[]
  priceMin           Int?
  priceMax           Int?
  bedsTotal          Int?
  bedsOpen           Int?
  waitlistText       String?
  contactName        String?
  email              String?
  phone              String?
  city               String?
  province           String?
  website            String?
  availabilityStatus String?
  adminNotes         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user    User?
  matches Match[]
}

model Match {
  id        String      @id @default(cuid())
  score     Int
  status    MatchStatus @default(SUGGESTED)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  intakeId   String
  providerId String
  intake     Intake   @relation(fields: [intakeId], references: [id])
  provider   Provider @relation(fields: [providerId], references: [id])

  @@unique([intakeId, providerId])
}

model ActionLog {
  id         String   @id @default(cuid())
  type       String
  targetType String
  targetId   String
  label      String
  payload    Json?
  createdAt  DateTime @default(now())
}

enum Role {
  FAMILY
  PROVIDER
  ADMIN
}

enum IntakeStatus {
  NEW
  MATCHED
  REVIEW
  PLACED
  CLOSED
}

enum MatchStatus {
  SUGGESTED
  CONTACTED
  VISIT_REQUESTED
  CALLBACK_REQUESTED
  ACCEPTED
  DECLINED
  PLACED
  CLOSED
}

enum WaitlistType {
  FAMILY
  FACILITY
}

enum WaitlistStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model WaitlistEntry {
  id           String         @id @default(cuid())
  type         WaitlistType
  contactName  String
  email        String
  phone        String?
  city         String?
  province     String?
  message      String?
  relationship String?
  ageRange     String?
  careTypes    String[]       @default([])
  facilityName String?
  facilityType String?
  bedsTotal    Int?
  services     String[]       @default([])
  status       WaitlistStatus @default(NEW)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

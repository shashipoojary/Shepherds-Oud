generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(FAMILY)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedProviderId String?   @unique
  linkedProvider   Provider? @relation(fields: [linkedProviderId], references: [id])

  providerInvitesSent ProviderInvite[] @relation("ProviderInvitesSent")
  sessions            Session[]
  accounts            Account[]
  careCaseMemberships CareCaseMember[]
  pushSubscriptions   PushSubscription[]
  consentRecordsActor ConsentRecord[]  @relation("ConsentActor")
  consentRecordsSubject ConsentRecord[] @relation("ConsentSubject")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Provider {
  id                     String   @id @default(cuid())
  name                   String
  type                   String
  area                   String
  description            String   @default("")
  languages              String[]
  services               String[]
  careLevels             String[] @default([])
  dementiaCapacity       String?
  fundingTypes           String[] @default([])
  responseTimeHours      Int?
  visitAvailability      String?
  priceMin               Int?
  priceMax               Int?
  bedsTotal              Int?
  bedsOpen               Int?
  waitlistText           String?
  /// Estimated wait range in days (optional). Null = no estimate published.
  waitEstimateMinDays    Int?
  waitEstimateMaxDays    Int?
  /// When the wait estimate was last set or changed by the provider.
  waitEstimateUpdatedAt  DateTime?
  contactName            String?
  email                  String?
  phone                  String?
  city                   String?
  province               String?
  website                String?
  availabilityStatus     String?
  adminNotes             String?
  // UI locale for emails to this facility (nl | en); defaults to Dutch
  preferredLocale        String   @default("nl")
  verificationStatus     String   @default("REGISTRATION_RECEIVED")
  legalOrganisationName  String?
  kvkNumber              String?
  agbCode                String?
  wtzaStatus             String?
  roomTypes              String[] @default([])
  accessibilityNotes     String?
  qualityInfo            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user    User?
  directoryListing    DirectoryProvider?

  @@index([email])
}

model ActionLog {
  id         String   @id @default(cuid())
  type       String
  targetType String
  targetId   String
  label      String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum Role {
  FAMILY
  PROVIDER
  ADMIN
}

enum WaitlistType {
  FAMILY
  FACILITY
}

enum WaitlistStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model WaitlistEntry {
  id                    String         @id @default(cuid())
  type                  WaitlistType
  contactName           String
  email                 String
  phone                 String?
  city                  String?
  province              String?
  message               String?
  relationship          String?
  ageRange              String?
  careTypes             String[]       @default([])
  facilityName          String?
  facilityType          String?
  bedsTotal             Int?
  services              String[]       @default([])
  registrationNumber    String?
  registrationVerified  Boolean        @default(false)
  // UI locale when they registered (nl | en)
  preferredLocale       String         @default("nl")
  status                WaitlistStatus @default(NEW)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  providerInvites ProviderInvite[]

  @@index([status])
  @@index([email])
}

model ProviderInvite {
  id              String               @id @default(cuid())
  email           String
  tokenHash       String               @unique
  status          ProviderInviteStatus @default(PENDING)
  waitlistEntryId String?
  providerId      String?
  invitedById     String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  waitlistEntry WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id])
  invitedBy     User?          @relation("ProviderInvitesSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([waitlistEntryId])
  @@index([invitedById])
}

enum ProviderInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Durable outbound email jobs — Neon outbox + cron worker (no paid queue).
model EmailOutbox {
  id             String            @id @default(cuid())
  toJson         Json
  subject        String
  htmlContent    String            @db.Text
  textContent    String?           @db.Text
  status         EmailOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  nextAttemptAt  DateTime          @default(now())
  lastError      String?           @db.Text
  brevoMessageId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// --- Crisis Triage (primary family product) ---

model CareCase {
  id           String          @id @default(cuid())
  status       CareCaseStatus  @default(ACTIVE)
  urgencyLevel CareUrgency?
  chosenPath   CarePath?
  preferredLocale String       @default("nl")
  anonymousClaimToken String?  @unique
  claimedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  members       CareCaseMember[]
  triage        TriageResponse?
  tasks         ChecklistTask[]
  consents      ConsentRecord[]
  referrals     PlacementReferral[]

  @@index([status])
  @@index([anonymousClaimToken])
  @@index([updatedAt])
}

model CareCaseMember {
  id                    String               @id @default(cuid())
  caseId                String
  userId                String?
  role                  CareCaseMemberRole
  name                  String
  email                 String?
  phone                 String?
  preferredLocale       String               @default("nl")
  relationshipToPatient String?
  consentAuthorityType  ConsentAuthorityType?
  dateOfBirth           DateTime?
  mobilityStatus        String?
  cognitiveStatus       String?
  fundingContext        String[]             @default([])
  consentStatus         PatientConsentStatus @default(PENDING)
  visibilityPermissions String[]             @default([])
  inviteTokenHash       String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  careCase CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([userId])
  @@index([role])
}

model TriageResponse {
  id        String   @id @default(cuid())
  caseId    String   @unique
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  careCase CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model ChecklistTask {
  id           String              @id @default(cuid())
  caseId       String
  sortOrder    Int                 @default(0)
  label        String
  description  String              @db.Text
  deadline     DateTime?
  status       ChecklistTaskStatus @default(NOT_STARTED)
  externalLink String?
  staleNotifiedAt DateTime?
  deadlineNotifiedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  careCase CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, sortOrder])
  @@index([deadline])
  @@index([status])
}

model ConsentRecord {
  id            String               @id @default(cuid())
  caseId        String
  actorUserId   String?
  subjectUserId String?
  action        String
  authorityType ConsentAuthorityType?
  details       Json?
  createdAt     DateTime             @default(now())

  careCase CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor    User?    @relation("ConsentActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject  User?    @relation("ConsentSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

model DirectoryProvider {
  id             String                     @id @default(cuid())
  name           String
  type           DirectoryProviderType
  municipality   String
  city           String?
  address        String?
  languages      String[]                   @default([])
  fundingAccepted String[]                  @default([])
  contactEmail   String?
  contactPhone   String?
  websiteUrl     String?
  source         DirectoryProviderSource
  verifiedStatus DirectoryVerifiedStatus    @default(UNVERIFIED)
  notes          String?                    @db.Text
  linkedProviderId String?                  @unique
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  linkedProvider Provider?            @relation(fields: [linkedProviderId], references: [id], onDelete: SetNull)
  referrals      PlacementReferral[]

  @@index([municipality])
  @@index([type])
  @@index([verifiedStatus])
}

model PlacementReferral {
  id                 String            @id @default(cuid())
  caseId             String
  directoryProviderId String
  referredAt         DateTime          @default(now())
  confirmedAt        DateTime?
  feeStatus          PlacementFeeStatus @default(PENDING)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  careCase          CareCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  directoryProvider DirectoryProvider @relation(fields: [directoryProviderId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([directoryProviderId])
  @@index([feeStatus])
  @@index([referredAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CareCaseStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CareUrgency {
  TODAY
  THIS_WEEK
  THIS_MONTH
}

enum CarePath {
  HOME_CARE
  FACILITY
  BOTH
  UNDECIDED
}

enum CareCaseMemberRole {
  FAMILY
  PATIENT
}

enum ConsentAuthorityType {
  SELF_ATTESTED
  LEGAL_REPRESENTATIVE_ON_FILE
  PATIENT_GRANTED
}

enum PatientConsentStatus {
  PENDING
  GRANTED
  REVOKED
  NOT_APPLICABLE
}

enum ChecklistTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum DirectoryProviderType {
  RESIDENTIAL
  HOME_CARE
}

enum DirectoryProviderSource {
  GEMEENTE_WMO
  HAND_CURATED
}

enum DirectoryVerifiedStatus {
  UNVERIFIED
  VERIFIED
  HIDDEN
}

enum PlacementFeeStatus {
  PENDING
  INVOICED
  PAID
  DECLINED
}

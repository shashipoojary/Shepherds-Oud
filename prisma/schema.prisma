generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(FAMILY)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  linkedProviderId String?   @unique
  linkedProvider   Provider? @relation(fields: [linkedProviderId], references: [id])

  linkedHospitalId String?
  linkedHospital   Hospital? @relation(fields: [linkedHospitalId], references: [id])

  intakes             Intake[]
  guidedIntakes       Intake[]         @relation("CareGuideIntakes")
  hospitalReferrals   Intake[]         @relation("HospitalReferrals")
  providerInvitesSent ProviderInvite[] @relation("ProviderInvitesSent")
  hospitalInvitesSent HospitalInvite[] @relation("HospitalInvitesSent")
  sessions            Session[]
  accounts            Account[]
  careCaseMemberships CareCaseMember[]
  pushSubscriptions   PushSubscription[]
  consentRecordsActor ConsentRecord[]  @relation("ConsentActor")
  consentRecordsSubject ConsentRecord[] @relation("ConsentSubject")

  @@index([linkedHospitalId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

model Intake {
  id                        String       @id @default(cuid())
  contactName               String
  email                     String
  phone                     String
  relationship              String
  preferredArea             String
  ageRange                  String
  careTypes                 String[]
  urgency                   String
  budget                    String?
  fundingTypes              String[]     @default([])
  languages                 String[]
  // UI locale when the family submitted (nl | en) — drives family emails
  preferredLocale           String       @default("nl")
  additionalNeeds           String[]
  functionalNeeds           String[]     @default([])
  placementPreferences      String[]     @default([])
  livingSituation           String?
  moveInTimeline            String?
  mobility                  String?
  dementiaNeeds             String?
  hospitalDischargeDate     DateTime?
  decisionMakerName         String?
  decisionMakerRelationship String?
  seniorAgreedToSearch      String?
  decisionParticipants      String?
  emotionalSupportNeeds     String[]
  supportTypes              String[]
  notes                     String?
  preferredDistance         String?
  medicalSupportNeeds       String?
  personSafeTonight         String?
  urgentMedicalHelp         String?
  canRemainHomeTonight      String?
  caregiverBurnoutRisk      String?
  immediateRiskFlags        String[]     @default([])
  emergencyStopped          Boolean      @default(false)
  consentAcceptedAt         DateTime?
  consentVersion            String?
  caseOutcome               String?
  status                    IntakeStatus @default(NEW)
  careGuideId               String?
  carePathway               String?
  assessmentNotes           String?
  carePlanSummary           String?
  visitScheduledAt          DateTime?
  visitType                 String?
  visitProviderName         String?
  visitNotes                String?
  followUp7At               DateTime?
  followUp30At              DateTime?
  followUp90At              DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  /// Who submitted this intake — family self-serve vs hospital referral demo.
  referralSource        IntakeReferralSource @default(FAMILY_SELF)
  referringHospitalId   String?
  referredByUserId      String?

  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  careGuide      User?           @relation("CareGuideIntakes", fields: [careGuideId], references: [id])
  referringHospital Hospital?    @relation(fields: [referringHospitalId], references: [id])
  referredBy     User?           @relation("HospitalReferrals", fields: [referredByUserId], references: [id])
  matches        Match[]
  decisionMakers DecisionMaker[]

  @@index([careGuideId])
  @@index([userId])
  @@index([status])
  @@index([referralSource])
  @@index([referringHospitalId])
}

model DecisionMaker {
  id               String   @id @default(cuid())
  name             String
  relationship     String
  responsibilities String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  intakeId String
  intake   Intake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId])
}

model Provider {
  id                     String   @id @default(cuid())
  name                   String
  type                   String
  area                   String
  description            String   @default("")
  languages              String[]
  services               String[]
  careLevels             String[] @default([])
  dementiaCapacity       String?
  fundingTypes           String[] @default([])
  responseTimeHours      Int?
  visitAvailability      String?
  priceMin               Int?
  priceMax               Int?
  bedsTotal              Int?
  bedsOpen               Int?
  waitlistText           String?
  /// Estimated wait range in days (optional). Null = no estimate published.
  waitEstimateMinDays    Int?
  waitEstimateMaxDays    Int?
  /// When the wait estimate was last set or changed by the provider.
  waitEstimateUpdatedAt  DateTime?
  contactName            String?
  email                  String?
  phone                  String?
  city                   String?
  province               String?
  website                String?
  availabilityStatus     String?
  adminNotes             String?
  // UI locale for emails to this facility (nl | en); defaults to Dutch
  preferredLocale        String   @default("nl")
  verificationStatus     String   @default("REGISTRATION_RECEIVED")
  legalOrganisationName  String?
  kvkNumber              String?
  agbCode                String?
  wtzaStatus             String?
  roomTypes              String[] @default([])
  accessibilityNotes     String?
  qualityInfo            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user    User?
  matches Match[]
  calendarConnections ProviderCalendarConnection[]
  bookingSettings     ProviderBookingSettings?
  directoryListing    DirectoryProvider?

  @@index([email])
}

model ProviderCalendarConnection {
  id              String                   @id @default(cuid())
  providerId      String
  platform        CalendarPlatform
  accountEmail    String
  /// AES-GCM encrypted refresh token (or opaque token blob).
  refreshTokenEnc String
  accessTokenEnc  String?
  accessTokenExp  DateTime?
  calendarId      String
  calendarName    String?
  syncStatus      CalendarSyncStatus       @default(ACTIVE)
  connectedAt     DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookingSettingsAsActive ProviderBookingSettings[] @relation("ActiveCalendarConnection")

  @@unique([providerId, platform, accountEmail])
  @@index([providerId])
  @@index([syncStatus])
}

model ProviderBookingSettings {
  id                        String   @id @default(cuid())
  providerId                String   @unique
  visitDurationMinutes      Int      @default(60)
  callbackDurationMinutes   Int      @default(30)
  bufferMinutes             Int      @default(15)
  horizonDays               Int      @default(14)
  timezone                  String   @default("Europe/Amsterdam")
  activeCalendarConnectionId String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  provider                 Provider                    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  activeCalendarConnection ProviderCalendarConnection? @relation("ActiveCalendarConnection", fields: [activeCalendarConnectionId], references: [id], onDelete: SetNull)
}

model Match {
  id                 String      @id @default(cuid())
  score              Int
  status             MatchStatus @default(SUGGESTED)
  notes              String?
  familyFacingReason String?
  declineReason      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  schedulingMode     SchedulingMode?
  schedulingStatus   SchedulingStatus?
  proposedStartsAt   DateTime?
  proposedEndsAt     DateTime?
  alternateStartsAt  DateTime?
  alternateEndsAt    DateTime?
  confirmedStartsAt  DateTime?
  confirmedEndsAt    DateTime?
  calendarEventId    String?
  calendarPlatform   CalendarPlatform?
  schedulingExpiresAt DateTime?

  intakeId   String
  providerId String
  intake     Intake   @relation(fields: [intakeId], references: [id])
  provider   Provider @relation(fields: [providerId], references: [id])

  @@unique([intakeId, providerId])
  @@index([providerId])
  @@index([status])
  @@index([schedulingStatus])
}

model ActionLog {
  id         String   @id @default(cuid())
  type       String
  targetType String
  targetId   String
  label      String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

enum Role {
  FAMILY
  PROVIDER
  ADMIN
  HOSPITAL
}

enum IntakeReferralSource {
  FAMILY_SELF
  HOSPITAL
}

enum IntakeStatus {
  NEW
  CARE_GUIDE_ASSIGNED
  ASSESSMENT
  CARE_PLAN
  MATCHED
  VISIT_SCHEDULED
  PROVIDER_RESPONSE
  PLACEMENT_IN_PROGRESS
  PLACED
  FOLLOW_UP_7
  FOLLOW_UP_30
  FOLLOW_UP_90
  CLOSED
}

enum MatchStatus {
  SUGGESTED
  CONTACTED
  VISIT_REQUESTED
  CALLBACK_REQUESTED
  ACCEPTED
  DECLINED
  PLACED
  CLOSED
}

enum CalendarPlatform {
  GOOGLE
  MICROSOFT
}

enum CalendarSyncStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
}

enum SchedulingMode {
  CALENDAR
  MANUAL
}

enum SchedulingStatus {
  AWAITING_FAMILY
  AWAITING_PROVIDER
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum WaitlistType {
  FAMILY
  FACILITY
}

enum WaitlistStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

model WaitlistEntry {
  id                    String         @id @default(cuid())
  type                  WaitlistType
  contactName           String
  email                 String
  phone                 String?
  city                  String?
  province              String?
  message               String?
  relationship          String?
  ageRange              String?
  careTypes             String[]       @default([])
  facilityName          String?
  facilityType          String?
  bedsTotal             Int?
  services              String[]       @default([])
  registrationNumber    String?
  registrationVerified  Boolean        @default(false)
  // UI locale when they registered (nl | en)
  preferredLocale       String         @default("nl")
  status                WaitlistStatus @default(NEW)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  providerInvites ProviderInvite[]

  @@index([status])
  @@index([email])
}

model ProviderInvite {
  id              String               @id @default(cuid())
  email           String
  tokenHash       String               @unique
  status          ProviderInviteStatus @default(PENDING)
  waitlistEntryId String?
  providerId      String?
  invitedById     String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  waitlistEntry WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id])
  invitedBy     User?          @relation("ProviderInvitesSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([waitlistEntryId])
  @@index([invitedById])
}

enum ProviderInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  invites   HospitalInvite[]
  referrals Intake[]

  @@index([email])
}

model HospitalInvite {
  id          String               @id @default(cuid())
  email       String
  tokenHash   String               @unique
  status      HospitalInviteStatus @default(PENDING)
  hospitalId  String
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("HospitalInvitesSent", fields: [invitedById], references: [id])

  @@index([email])
  @@index([status])
  @@index([hospitalId])
  @@index([invitedById])
}

enum HospitalInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Durable outbound email jobs — Neon outbox + cron worker (no paid queue).
model EmailOutbox {
  id             String            @id @default(cuid())
  toJson         Json
  subject        String
  htmlContent    String            @db.Text
  textContent    String?           @db.Text
  status         EmailOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  nextAttemptAt  DateTime          @default(now())
  lastError      String?           @db.Text
  brevoMessageId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sentAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// --- Crisis Triage V2 (additive; legacy Intake/Match kept until cutover soak) ---

model CareCase {
  id           String          @id @default(cuid())
  status       CareCaseStatus  @default(ACTIVE)
  urgencyLevel CareUrgency?
  chosenPath   CarePath?
  preferredLocale String       @default("nl")
  anonymousClaimToken String?  @unique
  claimedAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  members       CareCaseMember[]
  triage        TriageResponse?
  tasks         ChecklistTask[]
  consents      ConsentRecord[]
  referrals     PlacementReferral[]

  @@index([status])
  @@index([anonymousClaimToken])
  @@index([updatedAt])
}

model CareCaseMember {
  id                    String               @id @default(cuid())
  caseId                String
  userId                String?
  role                  CareCaseMemberRole
  name                  String
  email                 String?
  phone                 String?
  preferredLocale       String               @default("nl")
  relationshipToPatient String?
  consentAuthorityType  ConsentAuthorityType?
  dateOfBirth           DateTime?
  mobilityStatus        String?
  cognitiveStatus       String?
  fundingContext        String[]             @default([])
  consentStatus         PatientConsentStatus @default(PENDING)
  visibilityPermissions String[]             @default([])
  inviteTokenHash       String?              @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  careCase CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([userId])
  @@index([role])
}

model TriageResponse {
  id        String   @id @default(cuid())
  caseId    String   @unique
  answers   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  careCase CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model ChecklistTask {
  id           String              @id @default(cuid())
  caseId       String
  sortOrder    Int                 @default(0)
  label        String
  description  String              @db.Text
  deadline     DateTime?
  status       ChecklistTaskStatus @default(NOT_STARTED)
  externalLink String?
  staleNotifiedAt DateTime?
  deadlineNotifiedAt DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  careCase CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, sortOrder])
  @@index([deadline])
  @@index([status])
}

model ConsentRecord {
  id            String               @id @default(cuid())
  caseId        String
  actorUserId   String?
  subjectUserId String?
  action        String
  authorityType ConsentAuthorityType?
  details       Json?
  createdAt     DateTime             @default(now())

  careCase CareCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor    User?    @relation("ConsentActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subject  User?    @relation("ConsentSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
}

model DirectoryProvider {
  id             String                     @id @default(cuid())
  name           String
  type           DirectoryProviderType
  municipality   String
  city           String?
  address        String?
  languages      String[]                   @default([])
  fundingAccepted String[]                  @default([])
  contactEmail   String?
  contactPhone   String?
  websiteUrl     String?
  source         DirectoryProviderSource
  verifiedStatus DirectoryVerifiedStatus    @default(UNVERIFIED)
  notes          String?                    @db.Text
  linkedProviderId String?                  @unique
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  linkedProvider Provider?            @relation(fields: [linkedProviderId], references: [id], onDelete: SetNull)
  referrals      PlacementReferral[]

  @@index([municipality])
  @@index([type])
  @@index([verifiedStatus])
}

model PlacementReferral {
  id                 String            @id @default(cuid())
  caseId             String
  directoryProviderId String
  referredAt         DateTime          @default(now())
  confirmedAt        DateTime?
  feeStatus          PlacementFeeStatus @default(PENDING)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  careCase          CareCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  directoryProvider DirectoryProvider @relation(fields: [directoryProviderId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([directoryProviderId])
  @@index([feeStatus])
  @@index([referredAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum CareCaseStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CareUrgency {
  TODAY
  THIS_WEEK
  THIS_MONTH
}

enum CarePath {
  HOME_CARE
  FACILITY
  BOTH
  UNDECIDED
}

enum CareCaseMemberRole {
  FAMILY
  PATIENT
}

enum ConsentAuthorityType {
  SELF_ATTESTED
  LEGAL_REPRESENTATIVE_ON_FILE
  PATIENT_GRANTED
}

enum PatientConsentStatus {
  PENDING
  GRANTED
  REVOKED
  NOT_APPLICABLE
}

enum ChecklistTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum DirectoryProviderType {
  RESIDENTIAL
  HOME_CARE
}

enum DirectoryProviderSource {
  GEMEENTE_WMO
  HAND_CURATED
}

enum DirectoryVerifiedStatus {
  UNVERIFIED
  VERIFIED
  HIDDEN
}

enum PlacementFeeStatus {
  PENDING
  INVOICED
  PAID
  DECLINED
}

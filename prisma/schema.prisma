generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(FAMILY)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  intakes Intake[]
  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Intake {
  id              String       @id @default(cuid())
  contactName     String
  email           String
  phone           String
  relationship    String
  preferredArea   String
  ageRange        String
  careTypes       String[]
  urgency         String
  budget          String?
  languages       String[]
  additionalNeeds String[]
  notes           String?
  status          IntakeStatus @default(NEW)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
  matches Match[]
}

model Provider {
  id           String   @id @default(cuid())
  name         String
  type         String
  area         String
  description  String
  languages    String[]
  services     String[]
  priceMin     Int?
  priceMax     Int?
  bedsTotal    Int?
  bedsOpen     Int      @default(0)
  waitlistText String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  matches Match[]
}

model Match {
  id         String      @id @default(cuid())
  score      Int
  status     MatchStatus @default(SUGGESTED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  intakeId   String
  providerId String
  intake     Intake   @relation(fields: [intakeId], references: [id])
  provider   Provider @relation(fields: [providerId], references: [id])
}

model ActionLog {
  id         String   @id @default(cuid())
  type       String
  targetType String
  targetId   String
  label      String
  payload    Json?
  createdAt  DateTime @default(now())
}

enum Role {
  FAMILY
  PROVIDER
  ADMIN
}

enum IntakeStatus {
  NEW
  MATCHED
  REVIEW
  PLACED
  CLOSED
}

enum MatchStatus {
  SUGGESTED
  VISIT_REQUESTED
  CALLBACK_REQUESTED
  ACCEPTED
  DECLINED
}

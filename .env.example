# App / Vercel
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_API_KEY="replace-with-better-auth-dashboard-api-key"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# Brevo Transactional Email (intake confirmations, waitlist, provider sign-in links)
BREVO_API_KEY="xkeysib-replace-with-brevo-api-key"
BREVO_FROM_EMAIL="care@shepherdsoud.nl"
BREVO_FROM_NAME="Shepherds Oud"
# Default Care Guide for new intakes (must match an admin Google account email in ADMIN_EMAILS)
ADVISOR_EMAIL="care@shepherdsoud.nl"

# Comma-separated Google account emails allowed to sign in as admin
ADMIN_EMAILS="advisor@example.com"
PROVIDER_EMAILS="provider@example.com"

# Production monitoring: GET /api/health (alert if status is not "ok")
ACTION_LOG_RETENTION_DAYS="90"
CRON_SECRET=

# Prelaunch vs production routing (redeploy after change).
# PRELAUNCH is read at runtime on the server (Vercel). NEXT_PUBLIC_PRELAUNCH is inlined at build for client nav.
# true  (default) = waitlist-only site; /family/* intake paths redirect to register.
# false           = full production; guided intake, dashboard, and matches are live.
PRELAUNCH="true"
NEXT_PUBLIC_PRELAUNCH="true"

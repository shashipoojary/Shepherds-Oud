# App / Vercel
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon PostgreSQL
# DATABASE_URL must be the Neon *pooled* connection string (host often contains -pooler).
# DIRECT_URL is the unpooled URL — use only for migrations (prisma migrate).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_API_KEY="replace-with-better-auth-dashboard-api-key"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# Brevo Transactional Email (intake confirmations, waitlist, provider/family magic links)
# Single source of truth for From: BREVO_FROM_EMAIL + BREVO_FROM_NAME (used by lib/email/brevo.ts).
# Use a Brevo-verified sender on an authenticated domain (DKIM/DMARC). Without domain auth,
# Brevo rewrites From to @<accountId>.brevosend.com even when this address is correct.
BREVO_API_KEY="xkeysib-replace-with-brevo-api-key"
BREVO_FROM_EMAIL="dominique@shepherdsoud.com"
BREVO_FROM_NAME="Shepherds Oud Care"
# Default Care Guide for new intakes (must match an admin Google account email in ADMIN_EMAILS)
ADVISOR_EMAIL="dominique@shepherdsoud.com"

# Comma-separated Google account emails allowed to sign in as admin
ADMIN_EMAILS="advisor@example.com"
PROVIDER_EMAILS="provider@example.com"

# Production monitoring: GET /api/health (alert if status is not "ok")
ACTION_LOG_RETENTION_DAYS="90"
# Used by /api/cron/retention and /api/cron/email-outbox (Authorization: Bearer …)
CRON_SECRET=

# Client: show Neon cold-start toast after this idle window (ms). Default 300000 (5 min).
NEXT_PUBLIC_DB_IDLE_MS="300000"

# Crisis triage is the primary family product (always on). Legacy NEXT_PUBLIC_CRISIS_V2 is ignored.
# Optional Web Push (PWA reminders). Without these, SW still registers but push subscribe is limited.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:dominique@shepherdsoud.com"

# Prelaunch vs production routing (redeploy after change).
# PRELAUNCH is read at runtime on the server (Vercel). NEXT_PUBLIC_PRELAUNCH is inlined at build for client nav.
# true  (default) = waitlist-only site; /family/* intake paths redirect to register.
# false           = full production; guided intake, dashboard, and matches are live.
PRELAUNCH="true"
NEXT_PUBLIC_PRELAUNCH="true"

# Company KvK (Chamber of Commerce). Leave empty until registered — legal page shows "Registration pending".
# Do not invent a number. Redeploy after setting (NEXT_PUBLIC_* is inlined at build).
NEXT_PUBLIC_KVK_NUMBER=""
# Optional registered address shown on /company (defaults to "Netherlands")
NEXT_PUBLIC_REGISTERED_ADDRESS=""

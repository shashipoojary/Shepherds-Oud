{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/email-outbox",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/scheduling-expiry",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/checklist-reminders",
      "schedule": "0 4 * * *"
    }
  ]
}
